{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Reservation": "http://localhost:8070",
    "Payment": "http://localhost:8060",
    "Loyalty": "http://localhost:8050",
    "Timeout": "00:00:02"
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "FailureWindow": "00:00:30",
    "OpenTimeout": "00:00:03"
  },
  "RetryQueue": {
    "RetryInterval": "00:00:10"
  }
}
